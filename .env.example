# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/novastore

# JWT Authentication
JWT_SECRET=super_secure_jwt_production_secret_key_987654321
JWT_EXPIRES_IN=7d

# Payment Processing (Stripe / Gateway)
# Private secret keys must remain server-side only
STRIPE_SECRET_KEY=sk_test_51MockPaymentGatewaySecretKey987654321
STRIPE_WEBHOOK_SECRET=whsec_mockWebhookSecretKey123456

# Media Storage (Cloudinary)
# API Secret must remain server-side only for generating signatures
